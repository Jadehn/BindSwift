# Copy to .env and fill in. Never commit .env.
ENV=production
DATABASE_URL=postgresql://bindswift_app:CHANGE_ME@localhost:5432/bindswift

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_KEY=
# python -c "import secrets; print(secrets.token_urlsafe(32))"
IP_HASH_SALT=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@howardanalytics.net
SMTP_PASSWORD=app-password-not-your-real-password
MAIL_FROM=Bindswift <you@howardanalytics.net>
BROKER_EMAIL=you@howardanalytics.net
PUBLIC_BASE_URL=https://bindswift.howardanalytics.net
EMAIL_ATTACH_PDFS=true

# Pick something unguessable, e.g. /ops-7f3k2
ADMIN_PATH=/admin
# Optional: lock admin to your own IPs (comma-separated)
ADMIN_IP_ALLOWLIST=

# Printed on the ACORDs (producer block)
AGENCY_NAME=Jaden Howard
PRODUCER_NAME=Jaden Howard
PRODUCER_PHONE=
PRODUCER_EMAIL=
PRODUCER_NPN=
# Your agency address, printed under the agency name on the ACORD 125 (use \n between lines)
AGENCY_ADDRESS=Howard Analytics\n123 Example St\nValley Stream, NY 11580

# Coterie (start in sandbox; your Coterie Integration Manager provides keys, agency ID and AKHash codes)
COTERIE_ENV=sandbox
COTERIE_PUBLISHABLE_KEY=
COTERIE_SECRET_KEY=
COTERIE_AGENCY_EXTERNAL_ID=
COTERIE_AKHASH={"handyman":"","plumbing":"","electrical":""}

# Hosting (Vercel)
TRUST_PROXY=vercel
ALLOWED_HOSTS=bindswift.com,www.bindswift.com

# Anti-spam + verification
REQUIRE_EMAIL_VERIFICATION=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
SOCRATA_APP_TOKEN=
